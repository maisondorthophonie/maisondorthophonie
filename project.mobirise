              "position": "absolute",
              "top": "0"
            },
            ".svg-1 path": {
              "fill": "@LineColor"
            },
            ".item-image": {
              "margin-right": "2rem"
            },
            "[class*=\" socicon-\"]:before": {
              "line-height": "1",
              "margin-left": "-1px"
            },
            ".soc-item::after": {
              "display": "none"
            },
            ".icon1": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@secondaryColor"
            },
            ".icon2": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@warningColor"
            },
            ".icon3": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@primaryColor"
            },
            "@media (max-width: 991px)": {
              ".col-sm-12": {
                "margin-bottom": "2rem"
              },
              ".group-title": {
                "margin-bottom": "10px",
                "margin-top": "0"
              },
              ".tips": {
                "width": "100%",
                "height": "auto",
                "max-width": "103px"
              }
            },
            "@media (max-width: 767px)": {
