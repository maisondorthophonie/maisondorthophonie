              "left": "0",
              "top": "0"
            },
            ".inner-dashed-border": {
              "stroke": "#ffffff",
              "left": "0",
              "top": "0",
              "width": "100%",
              "height": "100%"
            },
            ".button-svg:hover .inner-dashed-border": {
              "animation-play-state": "running",
              "stroke": "#ffffff"
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            "rect": {
              "position": "absolute",
              "width": "95%"
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 10px)",
              "padding-bottom": "(@paddingBottom * 8px)",
              ".title": {
                "text-align": "left"
              },
              ".dragArea": {
                "padding-left": "0rem"
              },
              ".mbr-section-title": {
                "text-align": "left"
              }
            },
            "@media (min-width: 767px)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)",
              ".container-fluid": {
                "padding": "0 1.8rem"
              }
            },
            "@media (min-width: 992px)": {
              ".dragArea": {
                "padding-left": "2rem"
              }
            },
            ".mbr-section-title span": {
