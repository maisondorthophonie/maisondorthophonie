              },
              ".nav-link": {
                "transition": "all 0.5s ease-out",
                "border-radius": "4rem !important",
                "border": "1px solid transparent",
                "position": "relative",
                "opacity": "1",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "height": "1px",
                  "width": "0",
                  "background-color": "@activeItems",
                  "transition": "all 0.3s ease-in-out"
                },
                "&:hover, &:focus": {
                  "color": "@activeItems !important",
                  "&::before": {
                    "width": "100%"
                  }
                }
              }
            },
            ".dropdown-menu": {
              "border-radius": "0",
              "box-shadow": "none",
              "text-align": "left",
              "@media (min-width: 992px)": {
                "padding": "18px 34px 22px",
                "min-width": "250px",
