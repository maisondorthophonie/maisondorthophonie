        {
          "alias": false,
          "_styles": {
            ".mbr-overlay": {
              "background-color": "@overlayColor",
              "opacity": "@overlayOpacity"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "img": {
              "width": "90%",
              "border-radius": "8px"
            },
            ".btn": {
              "border-radius": "30px",
              "padding": "0.7rem 2.4rem",
              "margin": "0",
              "position": "relative"
            },
            "textarea": {
              "min-height": "130px"
            },
            "H5": {
              "color": "#12265a "
            },
            "@media (max-width: 992px)": {
              "img": {
                "width": "100%"
              },
