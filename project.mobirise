                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "96%",
                "height": "100%",
                "border": "2px dashed @warningColor",
                "border-radius": "30px",
                "z-index": "-1"
              }
            },
            ".inner-dashed-border": {
              "stroke": "#ffffff",
              "left": "0",
              "top": "0",
              "width": "100%",
              "height": "100%"
            },
            ".button-svg:hover .inner-dashed-border": {
              "animation-play-state": "running",
              "stroke": "#ffffff"
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            ".svg1": {
              "position": "absolute",
              "padding": "2px",
              "rect": {
                "width": "~\"calc(100% - 4px)\"",
                "height": "~\"calc(100% - 4px)\""
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#232323"
            },
            ".mbr-section-title": {
              "color": "#232323"
            }
