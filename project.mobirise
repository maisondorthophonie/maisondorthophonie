            ".content-wrap": {
              "padding": "60px",
              "background-color": "@container",
              "@media (max-width: 992px)": {
                "padding": "30px 20px"
              },
              ".title-wrapper": {
                "margin-bottom": "54px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".mbr-section-title": {
                  "display": "inline-block",
                  "width": "60%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              },
              ".panel-group": {
                ".card": {
                  "position": "relative",
                  "padding": "30px",
                  "margin-top": "20px",
                  "background-color": "@card",
                  "@media (max-width: 992px)": {
                    "padding": "20px"
                  },
                  "&:first-child": {
                    "margin-top": "0"
                  },
                  ".card-header": {
                    "background-color": "transparent",
                    "border": "none",
                    "border-radius": "0",
                    "padding": "0",
                    ".panel-title": {
                      "display": "flex",
                      "justify-content": "space-between",
                      "align-items": "center",
                      "width": "100%",
                      ".panel-title-edit": {
                        "margin-bottom": "0"
                      },
                      ".icon-wrapper": {
                        "width": "40px",
                        "height": "40px",
                        "min-width": "40px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "margin-left": "30px",
                        "transition": "all 0.3s ease-in-out",
                        "border-radius": "100%",
                        "background-color": "@iconBg",
                        "@media (max-width: 992px)": {
                          "margin-left": "16px"
                        },
                        ".mbr-iconfont": {
                          "font-size": "16px",
                          "transition": "all 0.3s ease-in-out",
                          "color": "@icon"
                        }
                      },
                      "&:not(.collapsed)": {
                        ".icon-wrapper": {
                          "transform": "rotate(-45deg)"
                        }
                      }
                    }
                  },
                  ".panel-collapse": {
                    ".panel-body": {
                      "margin": "20px 0 0 0",
                      ".panel-text": {
                        "display": "inline-block",
                        "width": "60%",
                        "margin-bottom": "0",
                        "@media (max-width: 992px)": {
                          "width": "100%"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#404349"
            },
            ".panel-title-edit": {
              "color": "#404349"
            },
            ".panel-text": {
              "color": "#404349"
            },
            ".mbr-section-title, .title-wrapper, .tabs-wrapper": {
              "text-align": "left"
            }
          },
          "_customHTML": "<section class=\"list02 stockm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"container\" selected>\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" value=\"#b19a7c\" name=\"icon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#ffda77\" name=\"iconBg\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#ebffe5\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#faedca\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrap\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .tabs-wrapper\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>Проводит сертифицированный логопед Квебека. </b><br>Время обследования (от 30 мин до 4 часов) в зависимости от возраста и речевых нарушений.&nbsp;<br><b><br></b>Обследование на французком, английском, русском или украинском.\n<br>\n<br>Предоставляем чек для страховки и налогов.<br></h2>\n                    </div>\n                    <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                        <div class=\"card\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Консультация<b>&nbsp;&nbsp;</b></h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">✏️ Открытие персонального досье у логопеда\n<br>\n<br>✏️ Краткое интервью с родителями<br>\n<br>✏️ 30 минут обследования с ребёнком в игровой форме<br><br>✏️ Мы проверяем:<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ основные нарушений произношения звуков;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ понимание речи (импрессивная речь);<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ владение собственной речью (экспрессивная речь);\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ уровень развития игровой деятельности;\n<br>\n<br>✏️ Редактирование персональной программы развития речи<br>\n<br>✏️Рекомендации и/или направление (аудиолог, итд.) при необходимости</p><p></p><p></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Полное обследование детей дошкольного возраста (0 - 5 лет)</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">✏️ Открытие персонального досье у логопеда\n<br>\n<br>✏️ Краткое интервью с родителями<br>\n<br>✏️ 1-2 встречи (50 - 120 минут) для обследования в игровой форме<br><br>✏️ Проверяем :<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ речевую моторику;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ нарушения в произношения звуков;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ фонематические процессы (речевой слух, звуковой анализ);<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ импрессивную речь (понимание речи); <br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ экспрессивную речь (владение собственной речью);\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ кратковременную фонологическую память;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ уровень развития игровой деятельности;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ соответствие психоречевого развития ребёнка его возрасту;<br>\n<br>✏️ Детальный анализ результатов\n<br>\n<br>✏️ Редактирование официального рапорта (на русском или французском)\n<br>\n<br>✏️ Редактирование персональной программы развития речи<br>\n<br>✏️ Встреча (30-40 мин) для объяснения результатов и рекомендаций</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Полное обследование детей школьного возраста (6 - 17 лет)(устный язык и предпосылки к письменному языку)</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">✏️ Открытие персонального досье у логопеда\n<br>\n<br>✏️ Интервью с родителями для составления анамнеза<br>\n<br>✏️ 2-4 встречи (100 - 240 минут) для обследования<br>\n<br>✏️ Проверяем :\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ речевую моторику;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ нарушения в произношения звуков;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ фонематические процессы (речевой слух, звуковой анализ);\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ импрессивную речь (понимание речи);\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ экспрессивную речь (владение собственной речью);\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ кратковременную фонологическую память;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ уровень развития игровой деятельности;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;✅ соответствие психоречевого развития ребёнка его возрасту;<br>\n<br>✏️ Детальный анализ результатов\n<br>\n<br>✏️ Редактирование официального рапорта (на русском или французском)\n<br>\n<br>✏️ Редактирование персональной программы развития речи<br>\n<br>✏️ Встреча (30-40 мин) для объяснения результатов и рекомендаций<br><br></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Полное обследование детей школьного возраста (6 - 17 лет)(устный язык и письменный языки) - на фр/англ</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">✏️ Открытие персонального досье у логопеда\n<br>\n<br>✏️ Интервью с родителями для составления анамнеза\n<br>\n<br>✏️ 2-4 встречи (100 - 240 минут) для обследования\n<br>\n<br>✏️ Проверяем :\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ речевую моторику;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ нарушения в произношения звуков;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ фонематические процессы (речевой слух, звуковой анализ);\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ импрессивную речь (понимание речи);\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ экспрессивную речь (владение собственной речью);\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ чтение и письмо и соответсвие умений возрастным нормативам;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ кратковременную фонологическую память;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ уровень развития игровой деятельности;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ соответствие психоречевого развития ребёнка его возрасту;\n<br>\n<br>✏️ Детальный анализ результатов\n<br>\n<br>✏️ Редактирование официального рапорта (на французском или английском)\n<br>\n<br>✏️ Редактирование персональной программы развития речи\n<br>\n<br>✏️ Встреча (30-40 мин) для объяснения результатов и рекомендаций&nbsp;<br></p><p></p><p></p><br><p><br></p><p></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Обследование темпоритмических нарушениях речи (заикание)<div><b><br></b></div></h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">✏️Открытие персонального досье у логопеда<br><br>✏️Интервью с родителями 20-30 мин<br><br>✏️Возможен анализ аудио или видео записей из дома<br><br>✏️1-2 встречи (30 - 60 мин) для обследования<br><br>✏️Проверяем:<br><br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ речевую моторику;\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ нарушения в произношения звуков;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ особенности темпа, ритма и плавности речи;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ✅ степень тяжести заикания;<br><br>✏️Детальный анализ результатов<br><br>✏️Редактирование официального рапорта (на русском или французком)<br><br>✏️Редактирование персональных рекомендаций<br><br>✏️Встреча 30-40 мин для обьяснения результатов и рекомендаций</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">\n                                        <b>Do you have catering services?</b>\n                                    </h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                        Yes, we offer catering services for events of all sizes. Please contact our\n                                        catering department for more information and to discuss your specific needs.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "list02-58",
          "_isUserblock": true,
          "_cid": "uwFrnzNxCe",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".container-fluid": {
              "padding-right": "1.5rem",
              "padding-left": "1.5rem",
              "max-width": "1200px"
            },
            ".btn": {
              "position": "relative",
              "padding": "0.7rem 2.4rem"
            },
            ".btn:hover .inner-dashed-border": {
              "animation-play-state": "running"
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            ".svg1": {
              "position": "absolute",
              "padding": "2px",
              "rect": {
                "width": "~\"calc(100% - 4px)\"",
                "height": "~\"calc(100% - 4px)\""
              }
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)",
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".title": {
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "margin-top": "1rem",
                "text-align": "center"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "info1",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section class=\"info kidsm4_info1\" group=\"Call To Action\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"2\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"5\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n\t\t<input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/children.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#faedca\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/201169087\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/children.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n\t\t\t<div class=\"col-lg-9 col-md-8 title\" mbr-class=\"{'align-right' : reverse}\" mbr-if=\"showTitle\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style line-bg-warning\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\">Наши программы<br></h2>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-3 col-md-4\" mbr-class=\"{'align-right' : !reverse}\" mbr-if=\"showButtons\">\n\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-7\" class=\"button-svg mbr-section-btn\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"tel:+1-514-2965324\" data-app-placeholder=\"Type Text\">Связаться</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "umbPGpsNF6",
          "_anchor": "info1-k",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "list02",
          "_sourceTheme": "stockm5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrap": {
              "padding": "60px",
              "background-color": "@container",
              "@media (max-width: 992px)": {
                "padding": "30px 20px"
              },
              ".title-wrapper": {
                "margin-bottom": "54px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".mbr-section-title": {
                  "display": "inline-block",
                  "width": "60%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              },
              ".panel-group": {
                ".card": {
                  "position": "relative",
                  "padding": "30px",
                  "margin-top": "20px",
                  "background-color": "@card",
                  "@media (max-width: 992px)": {
                    "padding": "20px"
                  },
                  "&:first-child": {
                    "margin-top": "0"
                  },
                  ".card-header": {
                    "background-color": "transparent",
                    "border": "none",
                    "border-radius": "0",
                    "padding": "0",
                    ".panel-title": {
                      "display": "flex",
                      "justify-content": "space-between",
                      "align-items": "center",
                      "width": "100%",
                      ".panel-title-edit": {
                        "margin-bottom": "0"
                      },
                      ".icon-wrapper": {
                        "width": "40px",
                        "height": "40px",
                        "min-width": "40px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "margin-left": "30px",
                        "transition": "all 0.3s ease-in-out",
                        "border-radius": "100%",
                        "background-color": "@iconBg",
                        "@media (max-width: 992px)": {
                          "margin-left": "16px"
                        },
                        ".mbr-iconfont": {
                          "font-size": "16px",
                          "transition": "all 0.3s ease-in-out",
                          "color": "@icon"
                        }
                      },
                      "&:not(.collapsed)": {
                        ".icon-wrapper": {
                          "transform": "rotate(-45deg)"
                        }
                      }
                    }
                  },
                  ".panel-collapse": {
                    ".panel-body": {
                      "margin": "20px 0 0 0",
                      ".panel-text": {
                        "display": "inline-block",
                        "width": "60%",
                        "margin-bottom": "0",
                        "@media (max-width: 992px)": {
                          "width": "100%"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#404349"
            },
            ".panel-title-edit": {
              "color": "#404349"
            },
            ".panel-text": {
              "color": "#404349"
            },
            ".mbr-section-title, .title-wrapper, .tabs-wrapper": {
              "text-align": "left"
            }
          },
          "_customHTML": "<section class=\"list02 stockm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"container\" selected>\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" value=\"#b19a7c\" name=\"icon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#ffda77\" name=\"iconBg\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#ebffe5\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#faedca\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrap\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .tabs-wrapper\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>Работу проводит агент по коррекции речи под наблюдением сертифицированного логопеда.</b>&nbsp;<br><br>Работа на русском или украинском языках.\n<br>\n<br>Предоставляем чек для страховки и налогов.<br></h2>\n                    </div>\n                    <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                        <div class=\"card\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Работа<b> </b>по<b> </b>общему<b> </b>развитию<b> </b>речи</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">Групповые занятия по 60 минут проводятся агентом по коррекции речи под наблюдением сертифицированного логопеда Квебека. Мы помогаем вашему ребёнку развивать родную речь (русский или украинский). С учётом возраста и интересов каждой группы, в каждом цикле прорабатываются от 1 до 3 основных направлений речевого развития.<br><br><br>Предоставляем чеки для страховок и налогов.<br><br>✅ Обогащение словарного запаса<br>✅ Улучшение лексического доступа<br>✅ Улучшение произношения<br>✅ Развитие связной, грамматически правильной речи<br>✅ Развитие звуковой и интонационной культуры речи<br>✅ Развитие фонематического слуха<br>✅ Знакомство с книжной культурой<br>✅ Развитие логики, мышления и памяти</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Работа по персональной программе развития речи</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\"><i>***У ребёнка должен быть действующий рапорт логопедического обследования или индивидуальный план терапии***</i><br><br><i>Если обследование проводилось не в нашей клинике, первое занятие проводится в форме <b>КОНСУЛЬТАЦИИ</b> для определения оптимального индивидуального плана развития речи.<br></i><br>Индивидуальные занятия по 60 или 35 минут проводятся агентом по коррекции речи согласно индивидуальному плану терапии, разработанному сертифицированным логопедом. Занятия включают домашние задания для самостоятельной работы.&nbsp;<br></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Математика: увлекательное решение задач и развитие логического мышления для детей, которые пока не любят математику<b>&nbsp;</b></h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">Занятия по 60 минут, в зависимости от возраста. Решение задач – это упражнение, развивающее мышление; оно способствует воспитанию терпения, настойчивости, воли, пробуждению интереса к процессу поиска решения и даёт возможность испытать глубокое удовлетворение от удачного решения, формируя таким образом мотивационную сферу. Используется методика схематического чертежа. Занятия подходят для детей с <b>дискалькулией</b>.<br></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Курсы по развитию речи для родителей (цена варьируется)</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">Ателье для родителей проводятся агентом по коррекции речи. Мы помогаем вам грамотно поддерживать развитие родного языка у вашего ребёнка:<br><br>✏️ <b>Интерактивное чтение</b><br><br>✏️ <b>Общие принципы работы с ребёнком дома</b><br><br>✏️ <b>Что делать, если мой ребёнок не говорит (мутизм)</b><br><br>✏️ <b>Как стимулировать развитие речи у ребёнка с аутизмом</b></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Заполнение административных документов</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">Документы для заявок на получение субсидий от правительства в случае если тяжесть речевых нарушений соответствует критериям инвалидности&nbsp;<br><br>✏️ Demande de supplément pour enfant handicapé (SEH)<br><br>✏️ Crédit d'impôts pour personnes handicapées (CIPH)<br><br>✏️ Documents pour le programme Agir Tôt<br><br></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">\n                                        <b>Do you have catering services?</b>\n                                    </h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                        Yes, we offer catering services for events of all sizes. Please contact our\n                                        catering department for more information and to discuss your specific needs.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "list02-j",
          "_isUserblock": true,
          "_cid": "um7ZRLoFsN",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".container-fluid": {
              "max-width": "1200px",
              "padding": "0 1.5rem"
            },
            ".group-title": {
              "margin-top": "2.5rem",
              "margin-bottom": "1.5rem",
              "color": "#ffffff",
              "line-height": "1.6"
            },
            ".navbar-logo": {
              "width": "110px"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".text2": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".links": {
              "margin-top": "2rem",
              "color": "#ffffff",
              "line-height": "1.6"
            },
            ".navbar-brand": {
              "margin": "0rem",
              "width": "100%",
              "margin-top": "-1.5rem"
            },
            ".list-item": {
              "display": "flex",
              "padding": "0",
              "margin-bottom": "10px !important",
              "align-items": "center",
              ".item-image, .social-data": {
                "display": "inline-block",
                "vertical-align": "middle"
              }
            },
            ".tips": {
              "height": "75px",
              "width": "75px",
              "border-radius": "20px",
              "margin": "4px",
              "display": "inline-block"
            },
            ".socicon": {
              "font-size": "1.3rem",
              "border-radius": "100%",
              "width": "38px",
              "height": "38px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "transition": ".3s",
              "margin-right": "0.5rem"
            },
            ".socicon:hover": {
              "transform": "translate(0, -10px)"
            },
            ".socion1": {
              "background": "@secondaryColor"
            },
            ".socion2": {
              "background-color": "lighten(@infoColor, 35%)"
            },
            ".socion3": {
              "background-color": "lighten(@warningColor, -5%)"
            },
            ".social-list": {
              "margin-top": "2rem",
              "display": "block",
              "margin-bottom": "0",
              ".soc-item": {
                "display": "inline-block",
                "margin": "0 .3rem"
              },
              "a": {
                "transition": ".2s linear",
                "&:hover": {
                  "opacity": ".4"
                }
              }
            },
            ".wrapper": {
              "background": "@ColorBg",
              "padding": "2rem",
              "border-radius": "30px"
            },
            ".svg-1": {
              "position": "absolute",
              "top": "0"
            },
            ".svg-1 path": {
              "fill": "@LineColor"
            },
            ".item-image": {
              "margin-right": "2rem"
            },
            "[class*=\" socicon-\"]:before": {
              "line-height": "1",
              "margin-left": "-1px"
            },
            ".soc-item::after": {
              "display": "none"
            },
            ".icon1": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@secondaryColor"
            },
            ".icon2": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@warningColor"
            },
            ".icon3": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@primaryColor"
            },
            "@media (max-width: 991px)": {
              ".col-sm-12": {
                "margin-bottom": "2rem"
              },
              ".group-title": {
                "margin-bottom": "10px",
                "margin-top": "0"
              },
              ".tips": {
                "width": "100%",
                "height": "auto",
                "max-width": "103px"
              }
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)",
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".wrapper": {
                "padding": "1rem"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".timetable": {
              "color": "#232323"
            }
          },
          "_name": "footer1",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section class=\"footer1 kidsm4_footer1\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"8\">\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"4\">\n\t\t<select title=\"Icons\" name=\"iconsCount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\" selected>2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<select title=\"Images\" name=\"imagesCount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<input type=\"range\" inline name=\"list1Items\" title=\"List Items\" min=\"0\" max=\"5\" value=\"3\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showlogo\" checked>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Line\" name=\"LineColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Timetable\" name=\"ColorBg\" value=\"#ffda77\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"@PROJECT_PATH@/assets/images/children-1.jpg\" title=\"Image\">\n\t\t\t<input type=\"color\" value=\"#232323\" title=\"Color\" selected>\n\t\t\t<input type=\"video\" value=\"https://vimeo.com/201169087\" title=\"Video\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/children-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<svg class=\"svg-1\" data-name=\"Layer 2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1428 72.5\">\n\t\t<path class=\"cls-1\" d=\"M-114,154.33s27.33-13,128-23c0,0,2.33,5.67,12,9.34,0,0,14.67,54.33,62.67,20a33.44,33.44,0,0,0,22.66-4s33,18.33,53-21L393,165s120,16.08,263.5,7,346.5-23.29,352-22.41S1203,147.5,1314,183V110.5H-114Z\" transform=\"translate(114 -110.5)\"></path>\n\t</svg>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\">\n\t\t\t\t<div class=\"navbar-brand\" mbr-if=\"showlogo\">\n\t\t\t\t\t<div class=\"logo\">\n\t\t\t\t\t\t<a href=\"#\">\n\t\t\t\t\t\t\t<img class=\"navbar-logo\" src=\"@PROJECT_PATH@/assets/images/brown-grey-minimalist-beauty-and-spa-logo-3-220x220.png\" alt=\"Mobirise\">\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"links mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".links, .navbar-brand, .social-list\">Поможем вашему ребенку преодолеть речевые трудности.<br>Запишитесь на консультацию в Монреале сегодня<br>для его успешного будущего завтра!</p>\n\t\t\t\t<div class=\"social-list\" mbr-if=\"iconsCount > 0\">\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 0\">\n\t\t\t\t\t\t<a href=\"https://www.instagram.com/maisondorthophonie/\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socion1 socicon-instagram socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>1\">\n\t\t\t\t\t\t<a href=\"https://www.facebook.com/Maisondorthophonie/\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socion2 socicon-facebook socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>2\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion3\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>3\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-skype socicon socion1\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>4\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion2\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>5\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion3\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\" mbr-if=\"list1Items!=0\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Контакты</h3>\n\n\t\t\t\t<div class=\"mbr-row items mbr-white\" mbr-list mbr-list-grow=\"list1Items\">\n\t\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn icon1 mbrib-pin\" style=\"color: rgb(255, 218, 119); fill: rgb(255, 218, 119);\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">220 26e Avenue,&nbsp;</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">Lachine, QC H8S 3Y4</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn icon2 mbrib-mobile\" style=\"color: rgb(255, 164, 91); fill: rgb(255, 164, 91);\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">Phone:</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">(514) 296 - 5324</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn icon2 mobi-mbri-globe-2 mobi-mbri\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">maisondorthophonie@gmail.com</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">maria.polotskaia@gmail.com</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div></div>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12 img-list\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Фото</h3>\n\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/459534656_1961870824259564_6889641143240951609_n-150x207.jpg\" alt=\"Mobirise\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/441508138_1284391969614069_6066529347902632788_n-150x200.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>1\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/441940135_1409183573134943_4580577732269057388_n-150x200.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>2\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/436466701_969096871674497_8576114651637119949_n-150x200.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>3\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/gallery04.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>4\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/gallery05-1.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>5\">\n\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Часы работы</h3>\n\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t<p class=\"mbr-text timetable mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".timetable\">\n\t\t\t\t\t\tПн - Ср: 9am - 7pm <br>\n\t\t\t\t\t\tЧт - Пт: выходной<br>\n\t\t\t\t\t\tСб: 9am - 4pm <br>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
