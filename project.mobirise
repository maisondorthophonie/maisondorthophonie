        {
          "alias": false,
          "_styles": {
            ".mbr-overlay": {
              "background-color": "@overlayColor",
              "opacity": "@overlayOpacity"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "img": {
              "width": "90%",
              "border-radius": "8px"
            },
            ".btn": {
              "border-radius": "30px",
              "padding": "0.7rem 2.4rem",
              "margin": "0",
              "position": "relative"
            },
            "textarea": {
              "min-height": "130px"
            },
            "H5": {
              "color": "#12265a "
            },
            "@media (max-width: 992px)": {
              "img": {
                "width": "100%"
              },
              ".map-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            ".google-map": {
              "height": "95%",
              "position": "relative",
              "iframe": {
                "height": "100%",
                "width": "100%"
              },
              "[data-state-details]": {
                "color": "#6b6763",
                "font-family": "Montserrat",
                "height": "1.5em",
                "margin-top": "-0.75em",
                "padding-left": "1.25rem",
                "padding-right": "1.25rem",
                "position": "absolute",
                "text-align": "center",
                "top": "50%",
                "width": "100%"
              },
              "&[data-state]": {
                "background": "#e9e5dc"
              },
              "&[data-state=\"loading\"]": {
                "[data-state-details]": {
                  "display": "none"
                }
              }
            },
            "@media (max-width: 576px)": {
              ".col-auto": {
                "width": "100%",
                "text-align": "center"
              }
            },
            ".container-fluid": {
              "max-width": "1200px"
            },
            "svg": {
              "position": "relative",
              "left": "0",
              "top": "0"
            },
            ".inner-dashed-border": {
              "stroke": "#ffffff",
              "left": "0",
              "top": "0",
              "width": "100%",
              "height": "100%"
            },
            ".button-svg:hover .inner-dashed-border": {
              "animation-play-state": "running",
              "stroke": "#ffffff"
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            "rect": {
              "position": "absolute",
              "width": "95%"
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 10px)",
              "padding-bottom": "(@paddingBottom * 8px)",
              ".title": {
                "text-align": "left"
              },
              ".dragArea": {
                "padding-left": "0rem"
              },
              ".mbr-section-title": {
                "text-align": "left"
              }
            },
            "@media (min-width: 767px)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)",
              ".container-fluid": {
                "padding": "0 1.8rem"
              }
            },
            "@media (min-width: 992px)": {
              ".dragArea": {
                "padding-left": "2rem"
              }
            },
            ".mbr-section-title span": {
              "display": "inline-block"
            },
            ".mbr-text": {
