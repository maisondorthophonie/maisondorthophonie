        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".carousel-item": {
              "margin-top": "1.3rem",
              "justify-content": "center",
              "& > div": {
                "width": "100%"
              }
            },
            ".carousel-item.active, .carousel-item-next, .carousel-item-prev": {
              "display": "flex"
            },
            ".carousel-controls": {
              "a": {
                "transition": "opacity .5s",
                "font-size": "1.2rem",
                "span": {
                  "padding": "15px",
                  "border-radius": "50%",
                  "opacity": ".9"
                },
                "&:hover": {
                  "span": {
                    "opacity": "1"
                  }
                }
              }
            },
            ".signature, .desk": {
              "margin": "0"
            },
            ".mbr-text": {
              "border-radius": "30px",
              "color": "#ffffff",
              "position": "relative",
              "padding": "2rem"
            },
            ".mbr-text1": {
              "background-color": "@warningColor"
            },
            ".mbr-text2": {
              "background-color": "@secondaryColor"
            },
            ".mbr-text3": {
              "background-color": "@primaryColor"
            },
            ".mbr-section-subtitle": {
              "margin-top": "2rem",
              "margin-bottom": "0",
              "color": "#70747f"
            },
            ".img-block": {
              "display": "flex",
              "justify-content": "center",
              "margin-top": "2rem",
              "align-items": "center"
            },
            "img": {
              "width": "80px",
              "height": "80px",
              "border-radius": "50%",
              "margin": "0"
            },
            ".title-block": {
              "margin-left": "1rem"
            },
            ".signature": {
              "font-weight": "900",
              "color": "#12265a"
            },
            ".quote_svg": {
              "position": "absolute",
              "top": "calc(100% - 4px)",
              "width": "30px",
              "left": "40px"
            },
            ".quote_svg1": {
              "fill": "@warningColor"
            },
            ".quote_svg2": {
              "fill": "@secondaryColor"
            },
            ".quote_svg3": {
              "fill": "@primaryColor"
            },
            ".mbr-text::after": {
              "content": "'“'",
              "display": "inline-block",
              "position": "absolute",
              "top": "-1rem",
              "left": "1rem",
              "font-size": "15rem",
              "line-height": "1",
              "color": "rgba(255, 255, 255, 0.23)"
            },
            ".carousel-indicators li": {
              "background-color": "@ColorCircle",
              "width": "10px",
              "height": "10px",
              "border": "none",
              "border-radius": "50%"
            },
            ".carousel-indicators": {
              "position": "absolute",
              "margin-top": "2rem",
              "bottom": "0rem"
            },
            "ol": {
              "margin-bottom": "0"
            },
            ".carousel": {
              "display": "flex",
              "overflow": "hidden",
              "padding-bottom": "3rem"
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)",
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".col-md-4": {
                "padding": "0"
              },
              ".mbr-text": {
                "padding": "1rem"
              }
            },
            ".container-fluid": {
              "padding": "0 1rem",
              "max-width": "1200px"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "testimonials1",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section class=\"carousel slide testimonials-slider testimonials1 kidsm4_testimonials1\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&amp;&amp;bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"4\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked=\"\">\n\t\t<header>Card</header>\n\t\t<input type=\"checkbox\" title=\"Name\" name=\"showName\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showDesk\" checked=\"\">\n\t\t<select name=\"columns\" title=\"Columns\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected=\"\">3</option>\n\t\t</select>\n\t\t<input type=\"range\" inline=\"\" title=\"Carousel\" name=\"carouselItems\" min=\"1\" max=\"10\" step=\"1\" value=\"2\">\n\n\t\t<input type=\"color\" title=\"Indicators\" name=\"ColorCircle\" value=\"#45b3df\">\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\">\n\t\t<input type=\"range\" inline=\"\" title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"5000\" condition=\"showAutoplay\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax=\"\">\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/children-1.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/201169087\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/children-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&amp;&amp;bg.type !== 'color'\">\n\t\t<input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&amp;&amp;bg.type !== 'color'\">\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay&amp;&amp;bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container-fluid\">\n\t\t<h2 class=\"mbr-fonts-style mbr-section-title align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Avis de nos clients</h2>\n\t\t<h3 class=\"mbr-section-subtitle mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"></h3>\n\t\t<div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" mbr-class=\"{'pt-4':showTitle || showSubtitle}\">\n\t\t\t<div class=\"carousel-indicators\">\n\t\t\t\t<li data-slide-to=\"0\" data-bs-slide-to=\"0\" class=\"active\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 1\" data-slide-to=\"1\" data-bs-slide-to=\"1\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 2\" data-slide-to=\"2\" data-bs-slide-to=\"2\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 3\" data-slide-to=\"3\" data-bs-slide-to=\"3\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 4\" data-slide-to=\"4\" data-bs-slide-to=\"4\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 5\" data-slide-to=\"5\" data-bs-slide-to=\"5\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 6\" data-slide-to=\"6\" data-bs-slide-to=\"6\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 7\" data-slide-to=\"7\" data-bs-slide-to=\"7\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 8\" data-slide-to=\"8\" data-bs-slide-to=\"8\"></li>\n\t\t\t\t<li mbr-if=\"carouselItems> 9\" data-slide-to=\"9\" data-bs-slide-to=\"9\"></li>\n\t\t\t</div>\n\t\t\t<div mbr-list=\"\" mbr-list-grow=\"carouselItems\" class=\"carousel-inner\">\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"row justify-content-center\">\n\t\t\t\t\t\t<div class=\"col-md-4\">\n\t\t\t\t\t\t\t<div class=\"mbr-text mbr-text1 mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-article=\"\" data-app-selector=\".mbr-text\" data-multiline=\"\"><span style=\"font-size: 1.1rem; letter-spacing: 0px;\">Mon fils, qui a sept ans, avait besoin d'une aide sérieuse pour parler,</span><div><span style=\"font-size: 1.1rem; letter-spacing: 0px;\">et nous sommes très heureux d'avoir fait appel à Maria.&nbsp; ...</span></div></div>\n\t\t\t\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/oksana.webp\" alt=\"\">\n\t\t\t\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\">Oksana Arbatova</h4>\n\t\t\t\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">\n\t\t\t\t\t\t\t\t\t\tmaman de Tim</h5>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"col-md-4\" mbr-if=\"columns>1\" mbr-class=\"{'d-none d-md-block': columns>1}\">\n\t\t\t\t\t\t\t<div class=\"mbr-text mbr-text2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-article=\"\" data-app-selector=\".mbr-text\" data-multiline=\"\">Мaria merci pour votre service ! Après des cours avec vous, les compétences d'Alice se sont nettement améliorées ! Grâce à votre professionnalisme et à votre approche personnalisée, l'enfant a non seulement fait des progrès en orthophonie, mais a également gagné en confiance en soi !</div>\n\t\t\t\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/ulyana-160x160.jpg\" alt=\"\">\n\t\t\t\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\">\n\t\t\t\t\t\t\t\t\t\tUlyana Evdokimova</h4>\n\t\t\t\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">maman d'alice</h5>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"col-md-4\" mbr-if=\"columns>2\" mbr-class=\"{'d-none d-md-block': columns>2}\">\n\t\t\t\t\t\t\t<div class=\"mbr-text mbr-text3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-article=\"\" data-app-selector=\".mbr-text\" data-multiline=\"\">Merci à tous les parents qui nous aident à aider les enfants!<svg class=\"quote_svg quote_svg3\" viewBox=\"0 0 259.43 367.5\">\n\t\t\t\t\t\t\t\t\t<path d=\"M.53,0H255.84c15,14-23.29,233.58.07,367.5C255.91,367.5-13.49,272.51.53,0Z\">\n\t\t\t\t\t\t\t\t\t</path>\n\t\t\t\t\t\t\t\t</svg></div>\n\t\t\t\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/screenshot%202024-07-18%20105329-160x146.png\" alt=\"\">\n\t\t\t\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\">\n\t\t\t\t\t\t\t\t\t\tBarbariska</h4>\n\t\t\t\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">&nbsp;le chat</h5>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"row justify-content-center\">\n\t\t\t\t\t\t<div class=\"col-md-4\">\n\t\t\t\t\t\t\t<div class=\"mbr-text mbr-text1 mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-article=\"\" data-app-selector=\".mbr-text\" data-multiline=\"\">Mon fils, qui a sept ans, avait besoin d'une aide importante pour améliorer la prononciation,<div>et nous sommes très heureux d'avoir fait appel à Maria. Il avait beaucoup de problèmes, mais<span style=\"font-size: 1.1rem; letter-spacing: 0px;\">&nbsp;grâce à son approche professionnelle, à sa patience et à son attention,</span></div><div>nous avons constaté des améliorations significatives assez rapidement. Les cours se déroulent</div><div>dans une atmosphère amicale et positive, ce qui aide notre fils à se sentir en confiance et à apprécier l<span style=\"font-size: 1.1rem; letter-spacing: 0px;\">es cours.</span></div></div>\n\t\t\t\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/oksana.webp\" alt=\"\">\n\t\t\t\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\">\n\t\t\t\t\t\t\t\t\t\tOksana Arbatova</h4>\n\t\t\t\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">\n\t\t\t\t\t\t\t\t\t\tmaman de Tim</h5>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"col-md-4\" mbr-if=\"columns>1\" mbr-class=\"{'d-none d-md-block': columns>1}\">\n\t\t\t\t\t\t\t<div class=\"mbr-text mbr-text2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-article=\"\" data-app-selector=\".mbr-text\" data-multiline=\"\">Maria, merci pour votre service ! Après des cours avec vous, les compétences d'Alice se sont nettement améliorées ! Grâce à votre professionnalisme et à votre approche personnalisée, l'enfant a non seulement fait des progrès en orthophonie, mais a également gagné en confiance en soi !</div>\n\t\t\t\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/ulyana-160x160.jpg\" alt=\"\">\n\t\t\t\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\">\n\t\t\t\t\t\t\t\t\t\tUlyana Evdokimova</h4>\n\t\t\t\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">\n\t\t\t\t\t\t\t\t\t\tmaman d'Alice</h5>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"col-md-4\" mbr-if=\"columns>2\" mbr-class=\"{'d-none d-md-block': columns>2}\">\n\t\t\t\t\t\t\t<div class=\"mbr-text mbr-text3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-article=\"\" data-app-selector=\".mbr-text\" data-multiline=\"\">Merci à tous les parents qui nous aident à aider les enfants!<svg class=\"quote_svg quote_svg3\" viewBox=\"0 0 259.43 367.5\">\n\t\t\t\t\t\t\t\t\t<path d=\"M.53,0H255.84c15,14-23.29,233.58.07,367.5C255.91,367.5-13.49,272.51.53,0Z\">\n\t\t\t\t\t\t\t\t\t</path>\n\t\t\t\t\t\t\t\t</svg></div>\n\t\t\t\t\t\t\t<div class=\"img-block\">\n\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/screenshot%202024-07-18%20105329-160x146.png\" alt=\"\">\n\t\t\t\t\t\t\t\t<div class=\"title-block\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style signature mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\">\n\t\t\t\t\t\t\t\t\t\tBarbariska</h4>\n\t\t\t\t\t\t\t\t\t<h5 class=\"desk mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".desk\">le chat</h5>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div></div>\n\t\t</div>\n\t</div>\n</section>",
