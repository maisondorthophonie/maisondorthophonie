        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)",
              "@media (max-width: 767px)": {
                "padding-top": "(@paddingTop * 5px)",
                "padding-bottom": "(@paddingBottom * 5px)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".container-fluid": {
              "max-width": "1200px",
              "padding": "0 1.5rem"
            },
            ".imageContainer": {
              "display": "inline-block",
              "position": "relative",
              "z-index": "0",
              "img": {
                "width": "100%",
                "border-radius": "30px"
              }
            },
            ".blue-block": {
              "background-color": "@secondaryColor",
              "display": "inline-block",
              "padding": "1rem",
              "border-radius": "30px",
              "position": "absolute",
              "bottom": "0",
              "right": "0",
              "transform": "translate(20%, 20%)"
            },
            "& when (@reverse)": {
              "@media (min-width: 992px)": {
                ".blue-block": {
                  "right": "auto",
                  "left": "0",
                  "transform": "translate(-20%, 20%)"
                }
              }
            },
            ".wrapper": {
              "color": "#ffffff",
              "border": "2px dashed contrast(@secondaryColor, darken(@secondaryColor, 50%), #ffffff, 60%)",
              "border-radius": "20px",
              "padding": "1.5rem"
            },
            ".blue-title": {
              "margin": "0",
              "line-height": "1.6"
            },
            ".text-blue": {
              "margin": "0",
              "font-weight": "900"
            },
            "@media (min-width: 992px)": {
              ".right-wrapper": {
                "padding-left": "3rem"
              }
            },
            ".btn": {
              "padding": "0.7rem 2.4rem",
              "position": "relative",
              "&:hover .inner-dashed-border": {
                "animation-play-state": "running"
              }
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "2rem",
              "color": "#232323"
            },
            ".mbr-text": {
              "margin-top": "2rem",
              "margin-bottom": "2.5rem"
            },
            ".svg1": {
              "position": "absolute",
              "padding": "2px",
              "rect": {
                "width": "~\"calc(100% - 4px)\"",
                "height": "~\"calc(100% - 4px)\""
              }
            },
            "@media (max-width: 991px)": {
              ".imageContainer img": {
                "margin-bottom": "2rem"
              },
              ".right-wrapper": {
                "padding-left": "1rem"
              },
              ".blue-block": {
                "transform": "translate(0)"
              }
            },
            "@media (max-width: 767px)": {
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".blue-block": {
                "width": "100%",
