bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n\t\t\t<div class=\"col-lg-6 col-md-12 imageContainer\">\n\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/mbr-1122x749.jpg\" alt=\"Mobirise\">\n\t\t\t\t<div class=\"blue-block\">\n\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t<h4 class=\"mbr-bold mbr-fonts-style blue-title\" mbr-theme-style=\"display-5\" data-app-selector=\".blue-title\" mbr-if=\"showTitle\">Мы работаем:</h4>\n\t\t\t\t\t\t<p class=\"text-blue mbr-normal mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".text-blue\">Пн - Ср: 9am - 7pm<br>Сб: 9am - 4pm</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"d-lg-block d-none col-lg-1\"></div>\n\t\t\t<div class=\"col-md-12 col-lg-5 py-4 right-wrapper\">\n\t\t\t\t<h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><span class=\"line-bg-warning\">Билингвизм-</span></h3>\n\t\t\t\t<h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\"><span class=\"line-bg-primary\">это здорово!</span></h4>\n\t\t\t\t<p class=\"mbr-text mbr-light mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Два разных языка для одного малыша — это хорошо или плохо? Может ли маленький ребенок овладеть несколькими языками одновременно? Как влияет двуязычие в семье на развитие ребенка? <b>Принесет ли это пользу?</b><br></p>\n\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-7\" class=\"button-svg mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page6.html#header2-1x\" data-app-placeholder=\"Type Text\">Читать далее</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n\t\t<a href=\"#next\">\n\t\t\t<i class=\"mbri-down mbr-iconfont\"></i>\n\t\t</a>\n\t</div>\n</section>",
