        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)",
              "@media (max-width: 767px)": {
                "padding-top": "(@paddingTop * 5px)",
                "padding-bottom": "(@paddingBottom * 5px)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".container-fluid": {
              "max-width": "1200px",
              "padding": "0 1.5rem"
            },
            ".imageContainer": {
              "display": "inline-block",
              "position": "relative",
              "z-index": "0",
              "img": {
                "width": "100%",
                "border-radius": "30px"
              }
            },
            ".blue-block": {
              "background-color": "@secondaryColor",
              "display": "inline-block",
              "padding": "1rem",
              "border-radius": "30px",
              "position": "absolute",
              "bottom": "0",
              "right": "0",
              "transform": "translate(20%, 20%)"
            },
            "& when (@reverse)": {
              "@media (min-width: 992px)": {
                ".blue-block": {
                  "right": "auto",
                  "left": "0",
                  "transform": "translate(-20%, 20%)"
                }
              }
            },
            ".wrapper": {
              "color": "#ffffff",
              "border": "2px dashed contrast(@secondaryColor, darken(@secondaryColor, 50%), #ffffff, 60%)",
              "border-radius": "20px",
              "padding": "1.5rem"
            },
            ".blue-title": {
              "margin": "0",
              "line-height": "1.6"
            },
            ".text-blue": {
              "margin": "0",
              "font-weight": "900"
            },
            "@media (min-width: 992px)": {
              ".right-wrapper": {
                "padding-left": "3rem"
              }
            },
            ".btn": {
              "padding": "0.7rem 2.4rem",
              "position": "relative",
              "&:hover .inner-dashed-border": {
                "animation-play-state": "running"
              }
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "2rem",
              "color": "#232323"
            },
            ".mbr-text": {
              "margin-top": "2rem",
              "margin-bottom": "2.5rem"
            },
            ".svg1": {
              "position": "absolute",
              "padding": "2px",
              "rect": {
                "width": "~\"calc(100% - 4px)\"",
                "height": "~\"calc(100% - 4px)\""
              }
            },
            "@media (max-width: 991px)": {
              ".imageContainer img": {
                "margin-bottom": "2rem"
              },
              ".right-wrapper": {
                "padding-left": "1rem"
              },
              ".blue-block": {
                "transform": "translate(0)"
              }
            },
            "@media (max-width: 767px)": {
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".blue-block": {
                "width": "100%",
                "position": "static",
                "transform": "translate(0)",
                "text-align": "center"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#232323"
            },
            ".mbr-section-title": {
              "color": "#232323"
            }
          },
          "_name": "content3",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section group=\"Article\" class=\"content3 kidsm4_content3\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n\t\t<input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\">\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/children-1.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/201169087\n            \">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/children-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n\t\t\t<div class=\"col-lg-6 col-md-12 imageContainer\">\n\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/mbr-1122x749.jpg\" alt=\"Mobirise\">\n\t\t\t\t<div class=\"blue-block\">\n\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t<h4 class=\"mbr-bold mbr-fonts-style blue-title\" mbr-theme-style=\"display-5\" data-app-selector=\".blue-title\" mbr-if=\"showTitle\">Heures de travail:</h4>\n\t\t\t\t\t\t<p class=\"text-blue mbr-normal mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".text-blue\">Lun - Mer : 9am - 7pm\n<br>Sam : 9am - 4pm</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"d-lg-block d-none col-lg-1\"></div>\n\t\t\t<div class=\"col-md-12 col-lg-5 py-4 right-wrapper\">\n\t\t\t\t<h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><span class=\"line-bg-warning\">Le bilinguisme-</span></h3>\n\t\t\t\t<h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\"><span class=\"line-bg-primary\">c'est génial!</span></h4>\n\t\t\t\t<p class=\"mbr-text mbr-light mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Deux langues différentes pour un seul bébé : c'est bien ou mal ? Un jeune enfant peut-il apprendre plusieurs langues en même temps ? Comment le bilinguisme à la maison affecte-t-il l'enfant ?\n<br>\n<br><b>Le bilinguisme dans la petite enfance n'entraîne PAS de retard de développement ni de problèmes de langage.</b><br></p>\n\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-7\" class=\"button-svg mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page11.html#header2-40\" data-app-placeholder=\"Type Text\">Lire la suite</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n\t\t<a href=\"#next\">\n\t\t\t<i class=\"mbri-down mbr-iconfont\"></i>\n\t\t</a>\n\t</div>\n</section>",
          "_anchor": "content3-3i",
          "_isUserblock": true,
          "_cid": "uu1rsSmPTE",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
