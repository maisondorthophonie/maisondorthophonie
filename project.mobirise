          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)",
              "@media (max-width: 767px)": {
                "padding-top": "(@paddingTop * 5px)",
                "padding-bottom": "(@paddingBottom * 5px)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".container-fluid": {
              "max-width": "1200px",
              "padding": "0 1.5rem"
            },
            ".imageContainer": {
              "display": "inline-block",
              "position": "relative",
              "z-index": "0",
              "img": {
                "width": "100%",
                "border-radius": "30px"
              }
            },
            ".blue-block": {
              "background-color": "@secondaryColor",
              "display": "inline-block",
              "padding": "1rem",
              "border-radius": "30px",
              "position": "absolute",
              "bottom": "0",
              "right": "0",
              "transform": "translate(20%, 20%)"
            },
            "& when (@reverse)": {
              "@media (min-width: 992px)": {
                ".blue-block": {
                  "right": "auto",
                  "left": "0",
                  "transform": "translate(-20%, 20%)"
                }
              }
            },
            ".wrapper": {
              "color": "#ffffff",
