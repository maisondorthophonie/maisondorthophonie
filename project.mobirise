          },
          "_name": "forms1",
          "_customHTML": "<section class=\"form\" group=\"Form\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <header>Map</header>\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2799.7252097464116!2d-73.68983952372761!3d45.43504037107348!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cc9168d1553c68b%3A0xd490449b898c57de!2s220%2026e%20Avenue%2C%20Lachine%2C%20QC%20H8S%203Y4!5e0!3m2!1sen!2sca!4v1724357601333!5m2!1sen!2sca&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\" value=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2799.7252097464116!2d-73.68983952372761!3d45.43504037107348!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cc9168d1553c68b%3A0xd490449b898c57de!2s220%2026e%20Avenue%2C%20Lachine%2C%20QC%20H8S%203Y4!5e0!3m2!1sen!2sca!4v1724357601333!5m2!1sen!2sca&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\">\n        <!-- <header>Style</header>\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#f2f6ff\" condition=\"customStyle\"> -->\n        \n        <!-- <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#f2f6ff\" condition=\"customStyle\"> -->\n        <!-- <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#232323\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#c1c1c1\" condition=\"customStyle\"> -->\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"@THEME_PATH@/components/_images/children.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay &amp;&amp; bg.type=='image')\"></div>\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 col-md-12 map-wrapper\">\n                <div class=\"google-map\" mbr-map=\"googleMap\">\n                </div>\n            </div>\n            <div mbr-form=\"\" class=\"col-lg-6 my-auto pb-4 mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"maisondorthophonie@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"form-row\">\n<div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\">Thanks for filling out the form! We'll contact you shortly.</div>\n<div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\">Oops...! some problem!</div>\n</div>\n<div class=\"dragArea form-row\">\n<div class=\"col-lg-12\">\n<h5 mbr-theme-style=\"display-2\" class=\"mbr-fonts-style mbr-section-title\">Контакты</h5>\n</div>\n<div class=\"col-lg-12\">\n<p mbr-theme-style=\"display-7\" mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style mbr-light\">Записаться на консультацию и узнать больше о наших программах</p>\n</div>\n<div data-for=\"Name\" class=\"col-lg-12 form-group\">\n<input type=\"text\" name=\"Name\" placeholder=\"Имя *\" data-form-field=\"Name\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value=\"\">\n</div>\n<div data-for=\"Email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<input type=\"email\" name=\"Email\" placeholder=\"Email *\" data-form-field=\"Email\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value=\"\">\n</div>\n<div class=\"col-lg-12 form-group\" data-for=\"Message\">\n<textarea name=\"Message\" placeholder=\"Сообщение\" data-form-field=\"Message\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n<div mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-lg-12 button-svg mbr-section-btn align-left\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 btn btn-primary\">Отправить</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n        </div>\n    </div>\n</section>",
          "_cid": "rHBb7VkcXz",
          "_anchor": "forms1-y",
          "_sourceTheme": "kidsm4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".container-fluid": {
              "max-width": "1200px",
              "padding": "0 1.5rem"
            },
            ".group-title": {
              "margin-top": "2.5rem",
              "margin-bottom": "1.5rem",
              "color": "#ffffff",
              "line-height": "1.6"
            },
            ".navbar-logo": {
              "width": "110px"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".text2": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".links": {
              "margin-top": "2rem",
              "color": "#ffffff",
              "line-height": "1.6"
            },
            ".navbar-brand": {
              "margin": "0rem",
              "width": "100%",
              "margin-top": "-1.5rem"
            },
            ".list-item": {
              "display": "flex",
              "padding": "0",
              "margin-bottom": "10px !important",
              "align-items": "center",
              ".item-image, .social-data": {
                "display": "inline-block",
                "vertical-align": "middle"
              }
            },
            ".tips": {
              "height": "75px",
              "width": "75px",
              "border-radius": "20px",
              "margin": "4px",
              "display": "inline-block"
            },
            ".socicon": {
              "font-size": "1.3rem",
              "border-radius": "100%",
              "width": "38px",
              "height": "38px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "transition": ".3s",
              "margin-right": "0.5rem"
            },
            ".socicon:hover": {
              "transform": "translate(0, -10px)"
            },
            ".socion1": {
              "background": "@secondaryColor"
            },
            ".socion2": {
              "background-color": "lighten(@infoColor, 35%)"
            },
            ".socion3": {
              "background-color": "lighten(@warningColor, -5%)"
            },
            ".social-list": {
              "margin-top": "2rem",
              "display": "block",
              "margin-bottom": "0",
              ".soc-item": {
                "display": "inline-block",
                "margin": "0 .3rem"
              },
              "a": {
                "transition": ".2s linear",
                "&:hover": {
                  "opacity": ".4"
                }
              }
            },
            ".wrapper": {
              "background": "@ColorBg",
              "padding": "2rem",
              "border-radius": "30px"
            },
            ".svg-1": {
              "position": "absolute",
              "top": "0"
            },
            ".svg-1 path": {
              "fill": "@LineColor"
            },
            ".item-image": {
              "margin-right": "2rem"
            },
            "[class*=\" socicon-\"]:before": {
              "line-height": "1",
              "margin-left": "-1px"
            },
            ".soc-item::after": {
              "display": "none"
            },
            ".icon1": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@secondaryColor"
            },
            ".icon2": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@warningColor"
            },
            ".icon3": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@primaryColor"
            },
            "@media (max-width: 991px)": {
              ".col-sm-12": {
                "margin-bottom": "2rem"
              },
              ".group-title": {
                "margin-bottom": "10px",
                "margin-top": "0"
              },
              ".tips": {
                "width": "100%",
                "height": "auto",
                "max-width": "103px"
              }
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)",
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".wrapper": {
                "padding": "1rem"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".timetable": {
              "color": "#232323"
            }
          },
          "_name": "footer1",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section class=\"footer1 kidsm4_footer1\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"8\">\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"4\">\n\t\t<select title=\"Icons\" name=\"iconsCount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\" selected>2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<select title=\"Images\" name=\"imagesCount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<input type=\"range\" inline name=\"list1Items\" title=\"List Items\" min=\"0\" max=\"5\" value=\"3\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showlogo\" checked>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Line\" name=\"LineColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Timetable\" name=\"ColorBg\" value=\"#ffda77\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"../_images/children.jpg\" title=\"Image\">\n\t\t\t<input type=\"color\" value=\"#232323\" title=\"Color\" selected>\n\t\t\t<input type=\"video\" value=\"https://vimeo.com/201169087\" title=\"Video\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/children.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<svg class=\"svg-1\" data-name=\"Layer 2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1428 72.5\">\n\t\t<path class=\"cls-1\" d=\"M-114,154.33s27.33-13,128-23c0,0,2.33,5.67,12,9.34,0,0,14.67,54.33,62.67,20a33.44,33.44,0,0,0,22.66-4s33,18.33,53-21L393,165s120,16.08,263.5,7,346.5-23.29,352-22.41S1203,147.5,1314,183V110.5H-114Z\" transform=\"translate(114 -110.5)\"></path>\n\t</svg>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\">\n\t\t\t\t<div class=\"navbar-brand\" mbr-if=\"showlogo\">\n\t\t\t\t\t<div class=\"logo\">\n\t\t\t\t\t\t<a href=\"#\">\n\t\t\t\t\t\t\t<img class=\"navbar-logo\" src=\"@PROJECT_PATH@/assets/images/brown-grey-minimalist-beauty-and-spa-logo-3-220x220.png\" alt=\"Mobirise\">\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"links mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".links, .navbar-brand, .social-list\">Поможем вашему ребенку преодолеть речевые трудности.<br>Запишитесь на консультацию в Монреале сегодня<br>для его успешного будущего завтра!</p>\n\t\t\t\t<div class=\"social-list\" mbr-if=\"iconsCount > 0\">\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 0\">\n\t\t\t\t\t\t<a href=\"https://www.instagram.com/maisondorthophonie/\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socion1 socicon-instagram socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>1\">\n\t\t\t\t\t\t<a href=\"https://www.facebook.com/Maisondorthophonie/\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socion2 socicon-facebook socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>2\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion3\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>3\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-skype socicon socion1\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>4\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion2\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>5\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion3\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\" mbr-if=\"list1Items!=0\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Контакты</h3>\n\n\t\t\t\t<div class=\"mbr-row items mbr-white\" mbr-list mbr-list-grow=\"list1Items\">\n\t\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn icon1 mbrib-pin\" style=\"color: rgb(255, 218, 119); fill: rgb(255, 218, 119);\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">220 26e Avenue,&nbsp;</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">Lachine, QC H8S 3Y4</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn icon2 mbrib-mobile\" style=\"color: rgb(255, 164, 91); fill: rgb(255, 164, 91);\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">Phone:</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">(514) 296 - 5324</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn icon2 mobi-mbri-globe-2 mobi-mbri\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">maisondorthophonie@gmail.com</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">maria.polotskaia@gmail.com</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div></div>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12 img-list\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Фото</h3>\n\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/441968318_975359307468414_1979161783393265999_n-150x113.jpg\" alt=\"Mobirise\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/maya%20book-150x200.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>1\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/441508138_1284391969614069_6066529347902632788_n-150x200.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>2\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/%D0%BC%D0%B0%D1%82%D0%B5%D1%80%D0%B8%D0%B0%D0%BB-150x113.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>3\">\n\t\t\t\t<img class=\"tips\" src=\"../_images/gallery/gallery04.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>4\">\n\t\t\t\t<img class=\"tips\" src=\"../_images/gallery/gallery05.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>5\">\n\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Часы работы</h3>\n\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t<p class=\"mbr-text timetable mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".timetable\">\n\t\t\t\t\t\tПн - Ср: 9am - 7pm <br>Сб : 9am - 4pm <br>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
