              "padding": "2px",
              "rect": {
                "width": "~\"calc(100% - 4px)\"",
                "height": "~\"calc(100% - 4px)\""
              }
            },
            ".mbr-section-btn": {
              "margin-left": "5px"
            },
            "iframe": {
              "border-radius": "30px"
            }
