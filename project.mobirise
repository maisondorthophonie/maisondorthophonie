          "_customHTML": "<section data-bs-version=\"5\" class=\"team2\" group=\"Team\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" xmlns=\"http://www.w3.org/1999/html\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" name=\"imageWidth\" title=\"Image\" min=\"2\" max=\"6\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showTitleText\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"cardShowTitle\" checked>\n        <input type=\"checkbox\" title=\"Role\" name=\"cardShowRole\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentCard\">\n        <input type=\"color\" title=\"Color\" name=\"cardBg\" value=\"#ebffe5\" condition=\"!transparentCard\">\n        <header condition=\"showSocial\">Social</header>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"5\" step=\"1\" value=\"1\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#0b2b5c\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#cebfaf\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row row-cols-2 gap-4 justify-content-center\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showSubtitle\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"></h3>\n                <p class=\"mbr-section-subtitle mbr-fonts-style align-center mb-5\" mbr-theme-style=\"display-5\" mbr-if=\"showTitleText\" data-app-selector=\".mbr-section-subtitle\">\n                    Meet our team\n                </p>\n            </div>\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <div class=\"card\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"row\">\n                            <div class=\"col-12 col-md-{{imageWidth}} pe-sm-3 pe-md-4\">\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/-600x600.jpg\" alt>\n                                </div>\n                            </div>\n                            <div class=\"col-12 col-md\">\n                                <div class=\"card-box px-3 py-4 p-md-4 py-md-5 pe-md-5\">\n                                    <h5 class=\"card-title mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"cardShowTitle\" data-app-selector=\".card-title\">Olga Sosnitska</h5>\n                                    <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"cardShowRole\" data-app-selector=\".card-subtitle\">\n                                        <b>Partner</b>\n                                    </h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Je suis orthophoniste et j'ai 19 ans d'expérience. Je suis titulaire de deux diplômes d'enseignement supérieur : pédagogique et correctionnel, et j'ai suivi plusieurs formations continues et je connais des méthodes non traditionnelles d'orthophonie, telles que la bioénergétique, la logorithmique, le massage de la sonde, bioenergoplastika, logoritmika, massage Su-jok. En 2010, j'ai suivi une formation de puéricultrice et de responsable de crèches, et en 2013, une formation d'orthophoniste-défectologue.<br></p>\n                                    <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n                                        <div class=\"soc-item\">\n                                            <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                            <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                            <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                            <a href=\"https://www.youtube.com/c/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                            <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"row\">\n                            <div class=\"col-12 col-md-{{imageWidth}} img-order ps-sm-3 ps-md-4\">\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/screenshot-2024-08-22-at-11.56.47-660x662.png\" alt>\n                                </div>\n                            </div>\n                            <div class=\"col-12 col-md\">\n                                <div class=\"card-box px-3 py-4 p-md-4 ps-md-5 py-md-5 card-box_left\">\n                                    <h5 class=\"card-title mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"cardShowTitle\" data-app-selector=\".card-title\">Elena Polotskaia</h5>\n                                    <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"cardShowRole\" data-app-selector=\".card-subtitle\">\n                                        <b>Partner</b>\n                                    </h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"><br>Elena Polotskaia est professeur au département d'éducation de l'Université du Québec en Outaouais (l'Université du Québec en Outaouais). Elle s'intéresse aux différentes théories liées à l'apprentissage et à l'enseignement des mathématiques et à la manière dont ces théories peuvent aider à créer un meilleur programme d'études et à préparer les futurs enseignants. Elena a de l'expérience dans l'enseignement des mathématiques à tous les niveaux d'apprentissage avec des apprenants en difficulté. Elle est convaincue que le plaisir de faire des mathématiques découle du pouvoir de la compréhension. Elena mène actuellement des recherches inspirées par la théorie de l'apprentissage développemental de Vasily Davydov, qui affirme que la pensée mathématique est accessible à tous. Elena participe à la réunion annuelle de la CMESG depuis 2008.</p>\n                                    <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n                                        <div class=\"soc-item\">\n                                            <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                            <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                            <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                            <a href=\"https://www.youtube.com/c/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                            <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_cid": "uu2bo7eGIz",
          "_anchor": "people2-4h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".container-fluid": {
              "max-width": "1200px",
              "padding": "0 1.5rem"
            },
            ".group-title": {
              "margin-top": "2.5rem",
              "margin-bottom": "1.5rem",
              "color": "#ffffff",
              "line-height": "1.6"
            },
            ".navbar-logo": {
              "width": "110px"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".text2": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".links": {
              "margin-top": "2rem",
              "color": "#ffffff",
              "line-height": "1.6"
            },
            ".navbar-brand": {
              "margin": "0rem",
              "width": "100%",
              "margin-top": "-1.5rem"
            },
            ".list-item": {
              "display": "flex",
              "padding": "0",
              "margin-bottom": "10px !important",
              "align-items": "center",
              ".item-image, .social-data": {
                "display": "inline-block",
                "vertical-align": "middle"
              }
            },
            ".tips": {
              "height": "75px",
              "width": "75px",
              "border-radius": "20px",
              "margin": "4px",
              "display": "inline-block"
            },
            ".socicon": {
              "font-size": "1.3rem",
              "border-radius": "100%",
              "width": "38px",
              "height": "38px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "transition": ".3s",
              "margin-right": "0.5rem"
            },
            ".socicon:hover": {
              "transform": "translate(0, -10px)"
            },
            ".socion1": {
              "background": "@secondaryColor"
            },
            ".socion2": {
              "background-color": "lighten(@infoColor, 35%)"
            },
            ".socion3": {
              "background-color": "lighten(@warningColor, -5%)"
            },
            ".social-list": {
              "margin-top": "2rem",
              "display": "block",
              "margin-bottom": "0",
              ".soc-item": {
                "display": "inline-block",
                "margin": "0 .3rem"
              },
              "a": {
                "transition": ".2s linear",
                "&:hover": {
                  "opacity": ".4"
                }
              }
            },
            ".wrapper": {
              "background": "@ColorBg",
              "padding": "2rem",
              "border-radius": "30px"
            },
            ".svg-1": {
              "position": "absolute",
              "top": "0"
            },
            ".svg-1 path": {
              "fill": "@LineColor"
            },
            ".item-image": {
              "margin-right": "2rem"
            },
            "[class*=\" socicon-\"]:before": {
              "line-height": "1",
              "margin-left": "-1px"
            },
            ".soc-item::after": {
              "display": "none"
            },
            ".icon1": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@secondaryColor"
            },
            ".icon2": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@warningColor"
            },
            ".icon3": {
              "font-size": "2rem",
              "font-weight": "300",
              "color": "@primaryColor"
            },
            "@media (max-width: 991px)": {
              ".col-sm-12": {
                "margin-bottom": "2rem"
              },
              ".group-title": {
                "margin-bottom": "10px",
                "margin-top": "0"
              },
              ".tips": {
                "width": "100%",
                "height": "auto",
                "max-width": "103px"
              }
            },
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)",
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".wrapper": {
                "padding": "1rem"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".timetable": {
              "color": "#232323"
            }
          },
          "_name": "footer1",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section class=\"footer1 kidsm4_footer1\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"8\">\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"4\">\n\t\t<select title=\"Icons\" name=\"iconsCount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\" selected=\"\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<select title=\"Images\" name=\"imagesCount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected=\"\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<input type=\"range\" inline=\"\" name=\"list1Items\" title=\"List Items\" min=\"0\" max=\"5\" value=\"3\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showlogo\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Line\" name=\"LineColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Timetable\" name=\"ColorBg\" value=\"#ffda77\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax=\"\">\n\t\t\t<input type=\"image\" value=\"\" title=\"Image\">\n\t\t\t<input type=\"color\" value=\"#232323\" title=\"Color\" selected=\"\">\n\t\t\t<input type=\"video\" value=\"https://vimeo.com/201169087\" title=\"Video\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t\t<input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<svg class=\"svg-1\" data-name=\"Layer 2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1428 72.5\">\n\t\t<path class=\"cls-1\" d=\"M-114,154.33s27.33-13,128-23c0,0,2.33,5.67,12,9.34,0,0,14.67,54.33,62.67,20a33.44,33.44,0,0,0,22.66-4s33,18.33,53-21L393,165s120,16.08,263.5,7,346.5-23.29,352-22.41S1203,147.5,1314,183V110.5H-114Z\" transform=\"translate(114 -110.5)\"></path>\n\t</svg>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\">\n\t\t\t\t<div class=\"navbar-brand\" mbr-if=\"showlogo\">\n\t\t\t\t\t<div class=\"logo\">\n\t\t\t\t\t\t<a href=\"#\">\n\t\t\t\t\t\t\t<img class=\"navbar-logo\" src=\"@PROJECT_PATH@/assets/images/brown%20grey%20minimalist%20beauty%20and%20spa%20logo%20(3)-220x220.png\" alt=\"Mobirise\">\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"links mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".links, .navbar-brand, .social-list\">Aidez votre enfant à surmonter ses difficultés langagières.<br>Prenez rendez-vous pour une consultation à Montréal dès aujourd'hui pour un avenir réussi demain !</p>\n\t\t\t\t<div class=\"social-list\" mbr-if=\"iconsCount > 0\">\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 0\">\n\t\t\t\t\t\t<a href=\"https://www.instagram.com/maisondorthophonie/\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-social socion1 socicon-instagram socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>1\">\n\t\t\t\t\t\t<a href=\"https://www.facebook.com/Maisondorthophonie/\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-social socion2 socicon-facebook socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>2\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion3\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>3\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-social socicon-skype socicon socion1\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>4\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion2\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount>5\">\n\t\t\t\t\t\t<a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n\t\t\t\t\t\t\t<div mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon socion3\" style=\"color: rgb(255, 255, 255);\"></div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\" mbr-if=\"list1Items!=0\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Contacts</h3>\n\n\t\t\t\t<div class=\"mbr-row items mbr-white\" mbr-list=\"\" mbr-list-grow=\"list1Items\">\n\t\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-btn icon1 mbrib-pin\" style=\"color: rgb(255, 218, 119); fill: rgb(255, 218, 119);\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">220 26e Avenue,&nbsp;</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">Lachine, QC H8S 3Y4</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-btn icon2 mbrib-mobile\" style=\"color: rgb(255, 164, 91); fill: rgb(255, 164, 91);\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">Phone:</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">(514) 296 - 5324</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t<div class=\"list-item col-sm-12\">\n\t\t\t\t\t\t<div class=\"item-image\">\n\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-btn icon2 mobi-mbri-globe-2 mobi-mbri\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"social-data\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">maisondorthophonie@gmail.com</h5>\n\t\t\t\t\t\t\t<h5 class=\"mbr-fonts-style text2\" mbr-theme-style=\"display-7\" data-app-selector=\".list-item, .social-data, .text2\">maria.polotskaia@gmail.com</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div></div>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12 img-list\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Photo</h3>\n\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/441968318_975359307468414_1979161783393265999_n-150x113.jpg\" alt=\"Mobirise\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/maya%20book-150x200.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>1\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/%D0%BC%D0%B0%D1%82%D0%B5%D1%80%D0%B8%D0%B0%D0%BB-150x113.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>2\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/459534656_1961870824259564_6889641143240951609_n-150x207.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>3\">\n\t\t\t\t<img class=\"tips\" src=\"@PROJECT_PATH@/assets/images/gallery04.jpg\" alt=\"Mobirise\" mbr-if=\"imagesCount>4\">\n\t\t\t\t<img class=\"tips\" src=\"false\" alt=\"Mobirise\" mbr-if=\"imagesCount>5\">\n\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-3 col-md-6 col-sm-12\">\n\t\t\t\t<h3 class=\"mbr-bold mbr-fonts-style group-title\" mbr-theme-style=\"display-5\" data-app-selector=\".group-title\" mbr-if=\"showTitle\">Heures de travail</h3>\n\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t<p class=\"mbr-text timetable mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".timetable\">Lun - Mer : 9am - 7pm\n<br>Sam : 9am - 4pm<br>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
