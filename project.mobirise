              "border-radius": "100%",
              "width": "38px",
              "height": "38px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "transition": ".3s",
              "margin-right": "0.5rem"
            },
            ".socicon:hover": {
