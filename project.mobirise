        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)",
              "@media (max-width: 767px)": {
                "padding-top": "(@paddingTop * 10px)",
                "padding-bottom": "(@paddingBottom * 10px)"
              }
            },
            ".content-row": {
              "& when (@mediaLeft)": {
                "-webkit-flex-direction": "row-reverse",
                "flex-direction": "row-reverse"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "img": {
              "width": "100%",
              "border-radius": "30px",
              "transform": "translate(1%, 5%)"
            },
            "@media (max-width: 767px)": {
              ".imageContainer": {
                "margin-left": "1rem",
                "margin-bottom": "3rem"
              },
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".mbr-section-btn": {
                "text-align": "center"
              },
              ".mbr-section-title": {
                "text-align": "center"
              },
              ".mbr-section-subtitle": {
                "text-align": "center"
              },
              ".right-wrapper": {
                "text-align": "center"
              }
            },
            "@media (min-width: 767px)": {
              ".container-fluid": {
                "padding": "0 1.4rem"
              },
              ".right-wrapper": {
                "padding-left": "5rem",
                "text-align": "left"
              }
            },
            "@media (min-width: 767px) and (max-width: 992px)": {
              ".imageContainer": {
                "margin-bottom": "4.2rem"
              },
              ".right-wrapper": {
                "padding-left": "1.2rem"
              }
            },
            "@media (min-width: 992px)": {
              "img": {
                "width": "100%"
              },
              ".mbr-section-btn": {
                "margin-left": "1px"
              }
            },
            ".btn": {
              "padding": "0.7rem 2.4rem",
              "margin": "0",
              "position": "relative"
            },
            ".container-fluid": {
              "max-width": "1200px"
            },
            ".mbr-text": {
              "margin-top": "1.5rem",
              "margin-bottom": "2.5rem"
            },
            "@media (max-width: 1200px)": {
              ".imageContainer": {
                "display": "inline-block",
                "position": "relative",
                "z-index": "0"
              },
              ".imageContainer::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "96%",
                "height": "100%",
                "border": "2px dashed @warningColor",
                "border-radius": "30px",
                "z-index": "-1"
              }
            },
            "@media (min-width: 1200px)": {
              ".imageContainer": {
                "display": "inline-block",
                "position": "relative",
                "z-index": "0"
              },
              ".imageContainer::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "96%",
                "height": "100%",
                "border": "2px dashed @warningColor",
                "border-radius": "30px",
                "z-index": "-1"
              }
            },
            ".inner-dashed-border": {
              "stroke": "#ffffff",
              "left": "0",
              "top": "0",
              "width": "100%",
              "height": "100%"
            },
            ".button-svg:hover .inner-dashed-border": {
              "animation-play-state": "running",
              "stroke": "#ffffff"
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            ".svg1": {
              "position": "absolute",
              "padding": "2px",
              "rect": {
                "width": "~\"calc(100% - 4px)\"",
                "height": "~\"calc(100% - 4px)\""
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#232323"
            },
            ".mbr-section-title": {
              "color": "#232323"
            }
          },
          "_name": "header2",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"25\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"25\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Additional</header>\n        <input type=\"checkbox\" title=\"Media On Right/Left\" name=\"mediaLeft\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/children-1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#faedca\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/201169087\n            \">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\n\n    <div class=\"container-fluid\">\n        <div class=\"row content-row\">\n            <div class=\"col-lg-6 col-md-12 imageContainer\">\n                <img src=\"@PROJECT_PATH@/assets/images/img-833-1125x1500.jpeg\" alt=\"Mobirise\">\n            </div>\n\n            <div class=\"col-md-12 col-lg-6 m-auto align-left right-wrapper\">\n                <h1 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><div></div></h1>\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\">Notre équipe rassemble des professionnelles qui partagent <b>notre mission d'aider les enfants à préserver et à développer leur langue maternelle (le russe ou l'ukrainien) dans l'environnement multilingue de Montréal</b>. Nous comprenons que la langue maternelle joue un rôle clé dans le développement de l'enfant et qu'elle est la base d'une acquisition réussie d'une deuxième langue. C'est pourquoi nos spécialistes travaillent en étroite collaboration avec les parents afin d'offrir une approche intégrale en matière de troubles du langage et de la parole.<div><br></div><div>Nous sommes fiers que notre équipe comprenne des orthophonistes expérimentés venant d'Ukraine. Ces spécialistes, qui travaillent en collaboration avec une orthophoniste agréée de l'Ordre des orthophonistes du Québec (OOAQ), aident les enfants à développer et à renforcer leur langue maternelle.&nbsp;</div><div><br></div><div>En collaboration avec les parents, nous apportons un soutien et une attention de qualité à chaque enfant, en l'aidant à atteindre son plein potentiel linguistique.</div></h3>\n                <p class=\"mbr-text mbr-light  mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"></p>\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"button-svg mbr-section-btn align-left\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"tel:+1-514-2965324\" data-app-placeholder=\"Type Text\">S'inscrire</a></div>\n              </div>\n            </div>\n\n\n        </div>\n\n\n\n    \n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>",
          "_anchor": "header2-4m",
