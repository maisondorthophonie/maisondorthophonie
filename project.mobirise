        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)",
              "@media (max-width: 767px)": {
                "padding-top": "(@paddingTop * 10px)",
                "padding-bottom": "(@paddingBottom * 10px)"
              }
            },
            ".content-row": {
              "& when (@mediaLeft)": {
                "-webkit-flex-direction": "row-reverse",
                "flex-direction": "row-reverse"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "img": {
              "width": "100%",
              "border-radius": "30px",
              "transform": "translate(1%, 5%)"
            },
            "@media (max-width: 767px)": {
              ".imageContainer": {
                "margin-left": "1rem",
                "margin-bottom": "3rem"
              },
              ".container-fluid": {
                "padding": "0 1rem"
              },
              ".mbr-section-btn": {
                "text-align": "center"
              },
              ".mbr-section-title": {
                "text-align": "center"
              },
              ".mbr-section-subtitle": {
                "text-align": "center"
              },
              ".right-wrapper": {
                "text-align": "center"
              }
            },
            "@media (min-width: 767px)": {
              ".container-fluid": {
                "padding": "0 1.4rem"
              },
              ".right-wrapper": {
                "padding-left": "5rem",
                "text-align": "left"
              }
            },
            "@media (min-width: 767px) and (max-width: 992px)": {
              ".imageContainer": {
                "margin-bottom": "4.2rem"
              },
              ".right-wrapper": {
                "padding-left": "1.2rem"
              }
            },
            "@media (min-width: 992px)": {
              "img": {
                "width": "100%"
              },
              ".mbr-section-btn": {
                "margin-left": "1px"
              }
            },
            ".btn": {
              "padding": "0.7rem 2.4rem",
              "margin": "0",
              "position": "relative"
            },
            ".container-fluid": {
              "max-width": "1200px"
            },
            ".mbr-text": {
              "margin-top": "1.5rem",
              "margin-bottom": "2.5rem"
            },
            "@media (max-width: 1200px)": {
              ".imageContainer": {
                "display": "inline-block",
                "position": "relative",
                "z-index": "0"
              },
              ".imageContainer::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "96%",
                "height": "100%",
                "border": "2px dashed @warningColor",
                "border-radius": "30px",
                "z-index": "-1"
              }
            },
            "@media (min-width: 1200px)": {
              ".imageContainer": {
                "display": "inline-block",
                "position": "relative",
                "z-index": "0"
              },
              ".imageContainer::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "96%",
                "height": "100%",
                "border": "2px dashed @warningColor",
                "border-radius": "30px",
                "z-index": "-1"
              }
            },
            ".inner-dashed-border": {
              "stroke": "#ffffff",
              "left": "0",
              "top": "0",
              "width": "100%",
              "height": "100%"
            },
            ".button-svg:hover .inner-dashed-border": {
              "animation-play-state": "running",
              "stroke": "#ffffff"
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            ".svg1": {
              "position": "absolute",
              "padding": "2px",
              "rect": {
                "width": "~\"calc(100% - 4px)\"",
                "height": "~\"calc(100% - 4px)\""
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#232323"
            },
            ".mbr-section-title": {
              "color": "#232323"
            }
          },
          "_name": "header2",
          "_customHTML": "<section group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"25\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"25\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Additional</header>\n        <input type=\"checkbox\" title=\"Media On Right/Left\" name=\"mediaLeft\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/children.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#faedca\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/201169087\n            \">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\n\n    <div class=\"container-fluid\">\n        <div class=\"row content-row\">\n            <div class=\"col-lg-6 col-md-12 imageContainer\">\n                <img src=\"@PROJECT_PATH@/assets/images/img-833-1125x1500.jpeg\" alt=\"Mobirise\">\n            </div>\n\n            <div class=\"col-md-12 col-lg-6 m-auto align-left right-wrapper\">\n                <h1 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Наша команда<div><br></div></h1>\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\">Наша команда объединяет специалистов, которые разделяют <b>нашу миссию — помочь детям сохранить и развить родную речь в многоязычной среде Монреаля</b>. Мы понимаем, что родной язык играет ключевую роль в развитии ребёнка и является основой для успешного овладения вторым языком. Именно поэтому наши специалисты работают в тесном сотрудничестве с родителями, обеспечивая комплексный подход к устранению речевых нарушений.<div><b><br></b></div><div>Мы гордимся тем, что в нашей команде есть опытные русскоязычные логопеды из Украины, России и других стран. Эти специалисты, работая в сотрудничестве с лицензированными логопедами Ордена Ортофонистов Квебека (OOAQ), помогают детям развивать и укреплять родную речь. В условиях нехватки логопедов в школах Монреаля, наша команда стремится предоставить необходимую помощь каждому ребёнку, создавая условия для их успешного языкового развития.</div></h3>\n                <p class=\"mbr-text mbr-light  mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Работая вместе с родителями и привлекая квалифицированных специалистов, мы обеспечиваем качественную поддержку и внимание каждому ребёнку, помогая ему раскрыть весь его языковой потенциал.</p>\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"button-svg mbr-section-btn align-left\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"tel:+1-514-2965324\" data-app-placeholder=\"Type Text\">Записаться</a></div>\n              </div>\n            </div>\n\n\n        </div>\n\n\n\n    \n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>",
          "_sourceTheme": "kidsm4",
          "_cid": "umc1VR1e9Z",
          "_anchor": "header2-o",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "@media (max-width: 767px)": {
              "padding-top": "(@paddingTop * 5px)",
              "padding-bottom": "(@paddingBottom * 5px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "title1",
          "_sourceTheme": "kidsm4",
          "_customHTML": "<section group=\"Titles\" class=\"title1 kidsm4_title1\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"5\">\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"2\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubTitle\">\n\t\t<select title=\"Align\" name=\"align\">\n\t\t\t<option value=\"1\">Left</option>\n\t\t\t<option value=\"2\" selected>Center</option>\n\t\t\t<option value=\"3\">Right</option>\n\t\t</select>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/children.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/201169087\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/children.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row\" mbr-class=\"{'justify-content-md-center':align==2, 'justify-content-md-end':align==3}\">\n\t\t\t<div class=\"col-sm-12 col-md-10 col-lg-7 align-center\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style line-bg-warning\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".row > div, .mbr-section-title\">\n\t\t\t\t\tНаши специалисты</h2>\n\t\t\t\t<br>\n\t\t\t\t<h3 class=\"mbr-section-subtitle mbr-fonts-style line-bg-primary\" mbr-theme-style=\"display-2\" mbr-if=\"showSubTitle\" data-app-selector=\".row > div, .mbr-section-subtitle\"></h3>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "umc87MO5nc",
          "_anchor": "title1-z",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "people2",
          "_sourceTheme": "estatem5",
          "_customHTML": "<section data-bs-version=\"5\" class=\"team2\" group=\"Team\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" xmlns=\"http://www.w3.org/1999/html\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" name=\"imageWidth\" title=\"Image\" min=\"2\" max=\"6\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showTitleText\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"cardShowTitle\" checked>\n        <input type=\"checkbox\" title=\"Role\" name=\"cardShowRole\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentCard\">\n        <input type=\"color\" title=\"Color\" name=\"cardBg\" value=\"#ebffe5\" condition=\"!transparentCard\">\n        <header condition=\"showSocial\">Social</header>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"5\" step=\"1\" value=\"1\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#0b2b5c\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/estatem5/components/_images/defaultbg/bg2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#cebfaf\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row row-cols-2 gap-4 justify-content-center\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showSubtitle\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"></h3>\n                <p class=\"mbr-section-subtitle mbr-fonts-style align-center mb-5\" mbr-theme-style=\"display-5\" mbr-if=\"showTitleText\" data-app-selector=\".mbr-section-subtitle\">\n                    Meet our team\n                </p>\n            </div>\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <div class=\"card\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"row\">\n                            <div class=\"col-12 col-md-{{imageWidth}} pe-sm-3 pe-md-4\">\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/298800676-151317150899997-1812185875143046748-n-1-530x530.png\" alt>\n                                </div>\n                            </div>\n                            <div class=\"col-12 col-md\">\n                                <div class=\"card-box px-3 py-4 p-md-4 py-md-5 pe-md-5\">\n                                    <h5 class=\"card-title mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"cardShowTitle\" data-app-selector=\".card-title\">Мария Полоцкая</h5>\n                                    <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"cardShowRole\" data-app-selector=\".card-subtitle\">\n                                        <b>Partner</b>\n                                    </h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                        Здравствуйте! Меня зовут Мария, я лицензированный логопед в Монреале и член Ордена Ортофонистов Квебека (OOAQ). Я закончила магистратуру в университете МакГилл и имею более 12 лет опыта работы в CSMB (Comission scolaire Marguerite Bourgeoys), крупнейшем образовательном комплексе Монреаля. Я работаю на трёх языках: русском, французском и английском, и готова помочь вашему ребёнку развить и укрепить его языковые навыки.\n                                    </p>\n                                    <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n                                        <div class=\"soc-item\">\n                                            <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                            <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                            <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                            <a href=\"https://www.youtube.com/c/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                            <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"row\">\n                            <div class=\"col-12 col-md-{{imageWidth}} img-order ps-sm-3 ps-md-4\">\n                                <div class=\"image-wrapper\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/screenshot-2024-08-22-at-11.50.44-668x664.png\" alt>\n                                </div>\n                            </div>\n                            <div class=\"col-12 col-md\">\n                                <div class=\"card-box px-3 py-4 p-md-4 ps-md-5 py-md-5 card-box_left\">\n                                    <h5 class=\"card-title mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"cardShowTitle\" data-app-selector=\".card-title\">Алла Илюшина</h5>\n                                    <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"cardShowRole\" data-app-selector=\".card-subtitle\">\n                                        <b>Partner</b>\n                                    </h6>\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                        Меня зовут Алла Илюшина, я из Одессы. Имею опыт работы учителем начальных классов, детским психологом и логопедом. Образование логопеда получила в университете им. К. Д. Ушинского. Разработала собственную методику коррекции, основанную на сенсорной интеграции и нейропсихологии. Успешно работала с детьми с СДВГ, РАС, синдромом Дауна и другими речевыми нарушениями.\n                                    </p>\n                                    <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n                                        <div class=\"soc-item\">\n                                            <a href=\"https://www.facebook.com/Mobirise/\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                            <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                            <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                            <a href=\"https://www.youtube.com/c/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                                            </a>\n                                        </div>\n                                        <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                            <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                                                <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".card:not(:nth-last-child(1))": {
              "margin-bottom": "2rem"
            },
            ".card-wrapper": {
              "background-color": "@cardBg",
              "border-radius": "16px",
              "& when (@transparentCard)": {
                "background-color": "transparent"
              }
            },
            ".image-wrapper": {
              "height": "100%",
              "img": {
                "height": "100%",
                "max-width": "100%",
                "object-fit": "cover"
              }
            },
            ".social-row": {
              ".soc-item": {
                "display": "inline-block",
                "text-align": "center",
                "border-radius": "10px",
                "margin-right": "0.6rem",
                "margin-bottom": "1rem",
                "padding": "0.5rem",
                "border": "2px solid @socialIconColor",
                "transition": "all 0.3s",
                ".mbr-iconfont": {
                  "display": "flex",
                  "justify-content": "center",
                  "align-content": "center",
                  "color": "@socialIconColor",
                  "font-size": "1.5rem",
                  "transition": "all 0.3s"
                },
                "&:hover": {
                  "background-color": "@socialIconColor",
                  ".mbr-iconfont": {
                    "color": "contrast(@socialIconColor)"
                  }
                }
              }
            },
            ".img-order": {
              "@media (min-width: 767px)": {
                "order": "2"
              }
            },
            "@media (min-width: 768px)": {
              ".card-box": {
                "&_left": {
                  "padding": "2rem 2rem 2rem 2rem"
                }
              }
            },
            "@media (min-width: 992px)": {
              ".card-box": {
                "&_left": {
                  "padding": "2rem 2rem 2rem 3rem"
                }
              }
            },
            ".card-title": {
              "color": "#232323"
            },
            ".mbr-text, .social-row": {
              "color": "#232323"
            }
          },
