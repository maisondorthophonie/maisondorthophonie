              "margin-left": "24px",
              "@media (max-width: 991px)": {
                "min-width": "auto",
                "max-width": "100%",
                "margin": "1rem 0 1rem 0"
              }
            },
            ".mbr-section-btn-main": {
              "@media (max-width: 991px)": {
                "margin-top": "1rem"
              },
              ".btn": {
                "padding": "10px 64px",
                "margin": "8px",
                "min-width": "120px",
                "white-space": "nowrap",
                "@media (max-width: 1200px)": {
                  "padding": "10px 32px"
                },
                "@media (max-width: 992px)": {
                  "margin-left": "0"
                }
              }
            },
            ".btn": {
              "min-height": "auto",
              "box-shadow": "none",
              "margin-top": "0",
              "&:hover": {
                "box-shadow": "none"
              }
            },
            ".nav-item": {
              "@media (min-width: 1200px)": {
                "margin": "4px 16px"
              },
              "@media (max-width: 991px)": {
                "margin": "0 !important"
              },
              ".nav-link": {
                "transition": "all 0.5s ease-out",
                "border-radius": "4rem !important",
                "border": "1px solid transparent",
                "position": "relative",
                "opacity": "1",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "height": "1px",
                  "width": "0",
                  "background-color": "@activeItems",
                  "transition": "all 0.3s ease-in-out"
                },
                "&:hover, &:focus": {
                  "color": "@activeItems !important",
                  "&::before": {
                    "width": "100%"
                  }
                }
              }
            },
            ".dropdown-menu": {
              "border-radius": "0",
              "box-shadow": "none",
              "text-align": "left",
              "@media (min-width: 992px)": {
                "padding": "18px 34px 22px",
                "min-width": "250px",
                "top": "auto !important",
                "left": "-40px !important",
                "&.dropdown-submenu": {
                  "left": "215px !important",
                  "top": "-45% !important"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".dropdown-menu .dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after, .link.dropdown-toggle::after": {
                "display": "inline-block",
                "width": "7px",
                "height": "7px",
                "margin-left": ".5rem",
                "margin-bottom": "2px",
                "content": "\"\"",
                "border": "2px solid",
                "border-left": "none",
                "border-top": "none",
                "transform": "rotate(-45deg)",
                "right": "15px",
                "position": "absolute",
