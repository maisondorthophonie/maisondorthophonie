              "border-radius": "20px",
              "padding": "1.5rem"
            },
            ".blue-title": {
              "margin": "0",
              "line-height": "1.6"
            },
            ".text-blue": {
              "margin": "0",
              "font-weight": "900"
            },
            "@media (min-width: 992px)": {
              ".right-wrapper": {
                "padding-left": "3rem"
              }
            },
            ".btn": {
              "padding": "0.7rem 2.4rem",
              "position": "relative",
              "&:hover .inner-dashed-border": {
                "animation-play-state": "running"
              }
            },
            "@keyframes dashed_border_running": {
              "100%": {
                "stroke-dashoffset": "-1000"
              }
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "2rem",
              "color": "#232323"
            },
