            ".mbr-text": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".text2": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".links": {
              "margin-top": "2rem",
              "color": "#ffffff",
              "line-height": "1.6"
            },
            ".navbar-brand": {
              "margin": "0rem",
              "width": "100%",
              "margin-top": "-1.5rem"
            },
            ".list-item": {
